{
  "version": 2,
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "header",
          "key": "content-type",
          "value": ".*application/json.*"
        }
      ]
    },
    {
      "source": "/register",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "header",
          "key": "content-type",
          "value": ".*application/json.*"
        }
      ]
    },
    {
      "source": "/portfolio",
      "destination": "/api/index.js",
      "has": [
        {
          "type": "header",
          "key": "authorization"
        }
      ]
    },
    {
      "source": "/portfolio/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
