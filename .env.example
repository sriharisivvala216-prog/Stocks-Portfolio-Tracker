# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION FOR VERCEL & PRODUCTION
# ==============================================================================

# JSON Web Token Secret Key for signing user authentication sessions
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Atlas Connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/stock_portfolio)
# If left unset, the backend automatically utilizes resilient in-memory SQLite storage
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stock_portfolio?retryWrites=true&w=majority

# Finnhub API Key for real-time live stock quotes (optional, demo key built-in)
FINNHUB_API_KEY=d302t41r01qnmrscnpa0d302t41r01qnmrscnpag

# Frontend API Base URL (leave empty on Vercel for same-domain serverless routing)
VITE_API_BASE_URL=
