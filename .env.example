# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (VERCEL / RENDER / LOCAL)
# ==============================================================================

# Port number for Express server (default: 5000)
PORT=5000

# JSON Web Token Secret Key for signing user authentication sessions
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Atlas Connection URI (REQUIRED for deployment)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/stock_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stock_portfolio?retryWrites=true&w=majority

# Finnhub API Key for real-time live stock quotes
FINNHUB_API_KEY=d302t41r01qnmrscnpa0d302t41r01qnmrscnpag

# Frontend API Base URL (leave empty on Vercel fullstack or set to Render backend URL)
VITE_API_BASE_URL=
